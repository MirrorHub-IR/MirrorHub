# Local deployment secrets
/config.local.php
/.env
/.env.*
!/.env.example

# Local backups and runtime logs
/backup*.json
/cron/monitor.log
/cron/*.log

# User-uploaded content (keep uploaded assets out of Git)
/uploads/

# Runtime setup lock (created only on the deployed host)
/.mirrorhub-installed

# Temporary private config file during atomic setup writes
/.config.local.php.tmp.*
